{
  "name": "llm-burst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "format": "prettier --check \"chrome_ext/content/injectors/claude.js\"",
    "format:fix": "prettier --write \"chrome_ext/content/injectors/claude.js\"",
    "lint": "eslint chrome_ext/content/injectors/claude.js",
    "lint:fix": "eslint chrome_ext/content/injectors/claude.js --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.playwright.json",
    "test:playwright": "playwright test",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:playwright"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "0.2.7",
    "@types/node": "^26.4.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
