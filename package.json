{
  "name": "llm-burst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "format": "prettier --check \"chrome_ext/content/injectors/claude.js\"",
    "format:fix": "prettier --write \"chrome_ext/content/injectors/claude.js\"",
    "lint": "eslint chrome_ext/content/injectors/claude.js",
    "lint:fix": "eslint chrome_ext/content/injectors/claude.js --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.playwright.json",
    "test:playwright": "playwright test",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:playwright"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "0.2.7",
    "@types/node": "^26.3.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67"
}
